# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.o
*.a
*.lib
*.dylib
*.dll

# Virtual Environments.
# Anchored to the repository root on purpose: an unanchored `env/` matches ANY directory
# called env at any depth, and on a case-insensitive filesystem `ENV/` matches it too.
# Between them they silently excluded the whole flysoul/env package - the mock arena and
# the SoulsGym wrapper - from version control.
/venv/
/env/
/ENV/
/env.bak/
/venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Local binaries & client tools
Moonlight/
*.tar
*.zip
*.gz

# IDE and editors
.vscode/
.idea/
*.swp
*.swo

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Homeostatic calibration cache: a build artifact, regenerated on demand.
checkpoints/

# Logs & temp files
*.log
scratch/
tmp/
